{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@aloneio/runmesh-runner",
  "version": "0.1.0-dev.2",
  "private": false,
  "type": "module",
  "description": "System Runner for Runmesh Agent Control Plane.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": { "type": "git", "url": "https://github.com/aloneio/runmesh.git", "directory": "apps/runner" },
  "homepage": "https://github.com/aloneio/runmesh",
  "bugs": { "url": "https://github.com/aloneio/runmesh/issues" },
  "main": "./dist/index.bundle.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.bundle.cjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.bundle.cjs"
      },
      "default": "./dist/index.bundle.cjs"
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      },
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "runmesh-runner": "./dist/coding-runner.cjs",
    "coding-runner": "./dist/coding-runner.cjs"
  },
  "files": ["dist", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-runner-declarations.mjs && node ../../scripts/clean-runner-bundles.mjs && node ../../scripts/build-runner-bundle.mjs ./src/coding-runner-entry.ts ./dist/coding-runner.cjs cjs && node ../../scripts/build-runner-bundle.mjs ./src/config.ts ./dist/config.cjs cjs && node ../../scripts/build-runner-bundle.mjs ./src/index.ts ./dist/index.bundle.cjs cjs",
    "prepack": "npm run build && node ../../scripts/clean-tsbuildinfo.mjs dist",
    "pack:check": "npm run prepack && npm pack --dry-run",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "start": "tsx src/coding-runner-entry.ts start"
  },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@aloneio/runmesh-protocol": "0.1.0-dev.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
