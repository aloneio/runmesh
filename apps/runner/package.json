{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@remote-coding-runtime/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "coding-runner": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "start": "tsx src/cli.ts start"
  },
  "dependencies": {
    "@remote-coding-runtime/protocol": "0.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.11"
  }
}
