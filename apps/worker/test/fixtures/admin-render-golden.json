      "admin-document"
    ],
    "allowed_change": "Fence detached central browser workflows and require operation-specific receipts. DOM regressions cover late OAuth responses after navigation, malformed write receipts, refresh-required no-replay behavior and unchanged MCP/Skill product flows; no screenshots.",
    "non_script_markup_unchanged": true
  },
  "direct_connection_review": {
    "source_base": "49ca444348aa26644f384232f0635dd8727f697e",
    "changed_cases": [
      "login",
      "setup",
      "secret",
      "admin-document"
    ],
    "allowed_change": "The saved service is rendered before OAuth handoff so a failed provider setup retains its visible recovery controls. The controller still owns lifecycle, shared admission and busy state. DOM regression verifies persisted service visibility and no automatic replay after failed handoff. No screenshots.",
    "non_script_markup_unchanged": true
  },
  "mcp_skill_presentation_review": {
    "source_base": "62239e1475b40c59bfd9235a57701fbef21631ba",
    "changed_cases": [
      "login",
      "setup",
      "secret",
      "clients-empty",
      "clients-populated",
      "admin-document"
    ],
    "allowed_change": "Rename customer navigation to MCP and Skill; show tool names and descriptions as plain cards with a count. Remove repeated sharing explanations and parameter/schema dumps. DOM regressions retain automatic connection, OAuth recovery, Skill installation and safe text rendering. No screenshots.",
    "unrelated_markup_unchanged": true
  },
  "tool_layout_review": {
    "source_base": "d8b877812873d86c8f937ced694b7cecb075d17f",
    "changed_cases": [
      "login",
      "setup",
      "secret",
      "admin-document"
    ],
    "allowed_change": "Scope wrapping to the MCP tool panel heading so 64-character names remain visible on mobile; preserve upstream tool title casing. Removing only the two CSS rules reproduces every prior hash. Browser checks measure actual header bounds without screenshots.",
    "unrelated_markup_unchanged": true
  },
  "library_content_layout_review": {
    "source_base": "8ee71c7ec4f926d32b09900d9d70ee9ee8de4fce",
    "changed_cases": [
      "login",
      "setup",
      "secret",
      "admin-document"
