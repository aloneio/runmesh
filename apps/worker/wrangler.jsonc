{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runmesh",
  "main": "src/production.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDOv2"
      },
      {
        "name": "RUNNER",
        "class_name": "RunnerDOv2"
      }
    ]
  },
  "vars": {
    "WORKER_ID": "worker-production",
    "RUNMESH_PUBLIC_ORIGIN": "https://runmesh.aloneio.workers.dev",
    "RUNMESH_SIGNED_RELEASE_AVAILABLE": "0.1.3",
    "RUNMESH_AUDIT_BACKEND": "d1",
    "RUNMESH_JOB_HISTORY_BACKEND": "d1"
  },
  "env": {
    "development": {
      "name": "runmesh-development",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-development",
        "RUNMESH_PUBLIC_ORIGIN": "",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": "",
        "RUNMESH_AUDIT_BACKEND": "sqlite",
        "RUNMESH_JOB_HISTORY_BACKEND": "sqlite"
      },
      "triggers": {
        "crons": []
      },
      "main": "src/index.ts",
      "exports": {}
    },
    "test": {
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-test",
        "RUNMESH_PUBLIC_ORIGIN": "",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": "",
        "RUNMESH_AUDIT_BACKEND": "sqlite",
        "RUNMESH_JOB_HISTORY_BACKEND": "sqlite"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "HISTORY_DB",
          "database_name": "runmesh-audit-test"
        }
      ],
      "main": "src/index.ts",
      "exports": {}
    },
    "production": {
      "name": "runmesh",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "vars": {
        "WORKER_ID": "worker-production",
        "RUNMESH_PUBLIC_ORIGIN": "https://runmesh.aloneio.workers.dev",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": "0.1.3",
        "RUNMESH_AUDIT_BACKEND": "d1",
        "RUNMESH_JOB_HISTORY_BACKEND": "d1"
      },
      "d1_databases": [
        {
          "binding": "HISTORY_DB",
          "database_name": "runmesh-audit-history"
        }
      ],
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "exports": {
        "RegistryDOv2": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RunnerDOv2": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RegistryDO": {
          "type": "durable-object",
          "state": "deleted"
        },
        "RunnerDO": {
          "type": "durable-object",
          "state": "deleted"
        }
      },
      "main": "src/production.ts"
    }
  },
  "d1_databases": [
    {
      "binding": "HISTORY_DB",
      "database_name": "runmesh-audit-history"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "exports": {
    "RegistryDOv2": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RunnerDOv2": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RegistryDO": {
      "type": "durable-object",
      "state": "deleted"
    },
    "RunnerDO": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}
