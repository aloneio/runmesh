{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runmesh",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDOv2"
      },
      {
        "name": "RUNNER",
        "class_name": "RunnerDOv2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryDO",
        "RunnerDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RegistryDOv2",
        "RunnerDOv2"
      ]
    }
  ],
  "vars": {
    "WORKER_ID": "worker-production",
    "RUNMESH_PUBLIC_ORIGIN": "https://runmesh.aloneio.workers.dev",
    "RUNMESH_SIGNED_RELEASE_AVAILABLE": "0.1.1"
  },
  "env": {
    "development": {
      "name": "runmesh-development",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-development",
        "RUNMESH_PUBLIC_ORIGIN": "",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": ""
      }
    },
    "test": {
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-test",
        "RUNMESH_PUBLIC_ORIGIN": "",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": ""
      }
    },
    "production": {
      "name": "runmesh",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-production",
        "RUNMESH_PUBLIC_ORIGIN": "https://runmesh.aloneio.workers.dev",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": "0.1.1"
      }
    }
  }
}
