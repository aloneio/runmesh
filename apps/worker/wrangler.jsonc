{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runmesh",
  "main": "src/production.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryDOv2"
      },
      {
        "name": "RUNNER",
        "class_name": "RunnerDOv2"
      }
    ]
  },
  "vars": {},
  "env": {
    "development": {
      "name": "runmeshdev",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          },
          {
            "name": "CAPABILITIES",
            "class_name": "CapabilitiesDOv1"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        },
        {
          "tag": "central-dev-v1",
          "new_sqlite_classes": [
            "CapabilitiesDOv1"
          ]
        }
      ],
      "vars": {
        "RUNMESH_ENVIRONMENT": "development",
        "CENTRAL_SKILLS_ENABLED": "1",
        "CENTRAL_DIRECT_TOOLS_ENABLED": "1",
        "CENTRAL_GOVERNANCE_ENABLED": "1"
      },
      "triggers": {
        "crons": []
      },
      "main": "src/index.ts",
      "exports": {},
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": []
    },
    "test": {
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          },
          {
            "name": "CAPABILITIES",
            "class_name": "CapabilitiesDOv1"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "RegistryDO",
            "RunnerDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "RegistryDOv2",
            "RunnerDOv2"
          ]
        },
        {
          "tag": "central-test-v1",
          "new_sqlite_classes": ["CapabilitiesDOv1"]
        }
      ],
      "vars": {
        "WORKER_ID": "worker-test",
        "RUNMESH_PUBLIC_ORIGIN": "",
        "RUNMESH_SIGNED_RELEASE_AVAILABLE": "",
        "RUNMESH_AUDIT_BACKEND": "sqlite",
        "RUNMESH_JOB_HISTORY_BACKEND": "sqlite"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "HISTORY_DB",
          "database_name": "runmesh-audit-test"
        }
      ],
      "main": "src/index.ts",
      "exports": {},
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "runmesh",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY",
            "class_name": "RegistryDOv2"
          },
          {
            "name": "RUNNER",
            "class_name": "RunnerDOv2"
          }
        ]
      },
      "vars": {},
      "d1_databases": [
        {
          "binding": "HISTORY_DB",
          "database_name": "runmesh-audit-history"
        }
      ],
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "exports": {
        "RegistryDOv2": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RunnerDOv2": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RegistryDO": {
          "type": "durable-object",
          "state": "deleted"
        },
        "RunnerDO": {
          "type": "durable-object",
          "state": "deleted"
        }
      },
      "main": "src/production.ts",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  },
  "d1_databases": [
    {
      "binding": "HISTORY_DB",
      "database_name": "runmesh-audit-history"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "exports": {
    "RegistryDOv2": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RunnerDOv2": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RegistryDO": {
      "type": "durable-object",
      "state": "deleted"
    },
    "RunnerDO": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "build": {
    "command": "node -e \"import(require('node:url').pathToFileURL(require.resolve('./scripts/prepare-worker-build.mjs',{paths:[process.cwd(),require('node:path').resolve('../..')]})))\""
  }
}
