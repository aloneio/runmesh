{
  "name": "@aloneio/runmesh-monorepo",
  "version": "0.1.0-dev.2",
  "private": true,
  "description": "A language-neutral protocol foundation for remote coding runtimes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aloneio/runmesh.git"
  },
  "homepage": "https://github.com/aloneio/runmesh",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run generate:version && tsc -b",
    "test": "npm run test --workspaces && npm run test:e2e",
    "test:unit": "npm run test --workspaces",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "typecheck": "npm run generate:version && tsc -b --pretty false",
    "validate:worker": "node ./scripts/validate-worker.mjs",
    "dev:worker": "npm run dev --workspace=@aloneio/runmesh-worker",
    "start:runner": "npm run start --workspace=@aloneio/runmesh-runner --",
    "pack:runner": "npm pack --workspace=@aloneio/runmesh-runner --dry-run",
    "pack:smoke": "node ./scripts/pack-smoke.mjs",
    "check:licenses": "node ./scripts/check-licenses.mjs",
    "set-version": "node ./scripts/set-version.mjs",
    "check:versions": "node ./scripts/check-versions.mjs",
    "generate:version": "node ./scripts/generate-version-modules.mjs",
    "check:format": "node ./scripts/check-format.mjs",
    "test:release-tools": "node --test ./test/release-tools.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
