{
  "name": "@aloneio/runmesh-protocol",
  "version": "0.1.0",
  "description": "Versioned JSON wire contract for Runmesh Runner and Worker.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/aloneio/runmesh.git", "directory": "packages/protocol" },
  "homepage": "https://github.com/aloneio/runmesh",
  "bugs": { "url": "https://github.com/aloneio/runmesh/issues" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./schema-artifact": {
      "types": "./dist/schema-artifact.d.ts",
      "default": "./dist/schema-artifact.js"
    }
  },
  "files": [
    "dist",
    "schema/wire-message.schema.json",
    "LICENSE",
    "LICENSES/Apache-2.0-history.txt",
    "LICENSE_HISTORY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "generate:schema": "tsx ./scripts/generate-schema.ts",
    "prepack": "npm run build && npm run generate:schema && rm -f dist/.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
